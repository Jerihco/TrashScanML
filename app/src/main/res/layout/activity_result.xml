<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back Button (Vector Icon) -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="#7DB559"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp"
            android:layout_gravity="start" />

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Result"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Item Name (ML Classification Result) -->
        <TextView
            android:id="@+id/item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Item name"
            android:textColor="#7DB559"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            tools:text="Paper" />

        <!-- Image -->
        <ImageView
            android:id="@+id/detectedImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:contentDescription="Detected image preview" />

        <!-- Smart Guide Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F7F7F7"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:elevation="2dp">

            <!-- Guide Title -->
            <TextView
                android:id="@+id/tvDisposalRecommendations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Guide to Disposing of Loading..."
                android:textColor="#7DB559"
                android:textStyle="bold"
                android:textSize="14sp"
                tools:text="Smart Guide to Disposing of Paper" />

            <!-- What to do / What not to do -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <!-- What to do -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What to do"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvWhatToDo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading..."
                        android:textColor="#333333"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"
                        tools:text="Rinse, remove label, dry" />
                </LinearLayout>

                <!-- What NOT to do -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What NOT to do"
                        android:textColor="#000000"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvWhatNotToDo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading..."
                        android:textColor="#333333"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"
                        tools:text="Don’t throw with liquids" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pro Tip -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pro Tip"
                android:textColor="#7DB559"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvProTip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="#333333"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                tools:text="Use as a planter or container" />
        </LinearLayout>

        <!-- Disposal Locations -->
        <TextView
            android:id="@+id/disposal_locations_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disposal Locations"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <!-- Map Placeholder -->
        <ImageView
            android:id="@+id/map_placeholder"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:contentDescription="Map showing disposal locations" />
    </LinearLayout>
</ScrollView>
